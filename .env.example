# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY='replace-me-with-a-generated-key'
DJANGO_DEBUG=True

# Only needed on a server (leave empty on your own computer):
#   DJANGO_ALLOWED_HOSTS - your site's address, e.g. calculator.example.com
#   DJANGO_DB_PATH       - where to keep the database, e.g. /data/db.sqlite3
DJANGO_ALLOWED_HOSTS=
DJANGO_DB_PATH=
