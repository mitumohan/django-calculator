# Optional: the app runs without a .env file. Copy this to .env only if you
# want to change a default:
#   cp .env.example .env

# Default: a random key, created once and saved in secret_key.txt.
# DJANGO_SECRET_KEY=your-own-key

# Default: False. Set to True on your own computer for detailed error pages.
DJANGO_DEBUG=True

# Default: * (any address). To lock it down: calculator.example.com
# DJANGO_ALLOWED_HOSTS=

# Default: /data/db.sqlite3 if a /data folder exists, otherwise db.sqlite3
# in the project folder.
# DJANGO_DB_PATH=
